--- a/chrome/common/chrome_paths_win.cc
+++ b/chrome/common/chrome_paths_win.cc
@@ -38,1 +38,9 @@
 bool GetDefaultUserDataDirectory(base::FilePath* result) {
+  // Only portable packages include this marker. Regular installations retain
+  // Chromium's default profile path under Local AppData.
+  base::FilePath exe_dir;
+  if (base::PathService::Get(base::DIR_EXE, &exe_dir) &&
+      base::PathExists(exe_dir.Append(L"portable.flag"))) {
+    *result = exe_dir.Append(L"UserData");
+    return true;
+  }
+
