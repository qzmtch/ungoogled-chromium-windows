--- a/chrome/install_static/user_data_dir.cc
+++ b/chrome/install_static/user_data_dir.cc
@@ -73,2 +73,21 @@
 bool GetDefaultUserDataDirectory(const InstallConstants& mode,
                                  std::wstring* result) {
+  // Portable build: use UserData beside chrome.exe by default.
+  // An explicit --user-data-dir is processed by GetUserDataDirectoryImpl()
+  // before this fallback is reached, so the command-line override is kept.
+  // Use the executable path, not the current working directory: Chrome changes
+  // its working directory while loading chrome.dll from the version folder.
+  constexpr DWORD kExecutablePathBufferSize = 32768;
+  wchar_t executable_path[kExecutablePathBufferSize];
+  const DWORD length = ::GetModuleFileNameW(
+      nullptr, executable_path, kExecutablePathBufferSize);
+  if (!length || length >= kExecutablePathBufferSize)
+    return false;
+
+  std::wstring user_data_dir(executable_path, length);
+  const size_t separator = user_data_dir.find_last_of(L"\\/");
+  if (separator == std::wstring::npos)
+    return false;
+
+  user_data_dir.resize(separator);
+  user_data_dir.append(L"\\UserData");
+  result->swap(user_data_dir);
+  return true;
+
--- a/chrome/common/chrome_paths_win.cc
+++ b/chrome/common/chrome_paths_win.cc
@@ -38,7 +38,6 @@
 bool GetDefaultUserDataDirectory(base::FilePath* result) {
-  if (!base::PathService::Get(base::DIR_LOCAL_APP_DATA, result))
+  if (!base::PathService::Get(base::DIR_EXE, result))
     return false;
-  *result = result->Append(install_static::GetChromeInstallSubDirectory());
-  *result = result->Append(chrome::kUserDataDirname);
+  *result = result->Append(L"UserData");
   return true;
 }
