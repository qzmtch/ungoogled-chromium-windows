--- a/chrome/install_static/user_data_dir.cc
+++ b/chrome/install_static/user_data_dir.cc
@@ -73,4 +73,24 @@
 bool GetDefaultUserDataDirectory(const InstallConstants& mode,
                                  std::wstring* result) {
+  // Resolve the default profile from this process' executable location.
+  // This remains correct when Chromium changes the working directory to the
+  // versioned DLL directory and when Chrome is relaunched by chrome://flags.
+  std::wstring executable_path(32768, L'\0');
+  const DWORD executable_path_length = ::GetModuleFileNameW(
+      nullptr, &executable_path[0],
+      static_cast<DWORD>(executable_path.size()));
+  if (executable_path_length > 0 &&
+      static_cast<size_t>(executable_path_length) < executable_path.size()) {
+    executable_path.resize(executable_path_length);
+    const std::wstring::size_type separator =
+        executable_path.find_last_of(L"\\/");
+    if (separator != std::wstring::npos) {
+      executable_path.resize(separator);
+      executable_path.append(L"\\UserData");
+      result->swap(executable_path);
+      return true;
+    }
+  }
+
   // This environment variable should be set on Windows Vista and later
   // (https://msdn.microsoft.com/library/windows/desktop/dd378457.aspx).
--- a/chrome/common/chrome_paths_win.cc
+++ b/chrome/common/chrome_paths_win.cc
@@ -38,7 +38,6 @@
 bool GetDefaultUserDataDirectory(base::FilePath* result) {
-  if (!base::PathService::Get(base::DIR_LOCAL_APP_DATA, result))
+  if (!base::PathService::Get(base::DIR_EXE, result))
     return false;
-  *result = result->Append(install_static::GetChromeInstallSubDirectory());
-  *result = result->Append(chrome::kUserDataDirname);
+  *result = result->Append(L"UserData");
   return true;
 }
